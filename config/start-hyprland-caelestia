#!/usr/bin/env bash
# Launch the Caelestia Hyprland session. Installed to /usr/local/bin by the
# Caelestia Fedora installer.
export CAELESTIA_SESSION=1

# GDM/Wayland sessions don't source the login shell's profile, so the per-user
# bin dirs may be missing. The Caelestia CLI (pipx) lives in ~/.local/bin and is
# launched by the Hyprland autostart, so make sure it is on PATH.
export PATH="${HOME}/.local/bin:${HOME}/bin:${PATH}"

# The upstream dotfiles expect these to be set by uwsm. We launch Hyprland
# directly, so set them here: without this the shell can end up on the X11
# (xcb) Qt platform and render nothing on a Hyprland/Wayland session.
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland
export QT_QPA_PLATFORM='wayland;xcb'
export GDK_BACKEND='wayland,x11'
export ELECTRON_OZONE_PLATFORM_HINT='auto'
export _JAVA_AWT_WM_NONREPARENTING=1

# VMware's vmwgfx driver mishandles surface-backed dmabufs, so Hyprland kills
# every GPU-accelerated Wayland client (the Caelestia shell included) and the
# session renders as a black screen. Until the upstream Hyprland fix lands
# (https://github.com/hyprwm/Hyprland/discussions/12966), fall back to software
# rendering inside VMware. Set CAELESTIA_VMWARE_HW=1 to opt out.
if [ -d /sys/module/vmwgfx ] && [ -z "${CAELESTIA_VMWARE_HW:-}" ]; then
    export LIBGL_ALWAYS_SOFTWARE=1
    export QSG_RHI_BACKEND=software
fi

# Caelestia config directories (used by the Hyprland entry point and shell).
export HYPRLAND_CAEL_CONFIG_DIR="$HOME/.config/caelestia-hypr"
export CAELESTIA_CONFIG_DIR="$HOME/.config/caelestia"
export STARSHIP_CONFIG="$HOME/.config/caelestia-starship.toml"
export QML_IMPORT_PATH="/usr/local/lib64/qt6/qml:${QML_IMPORT_PATH:-}"

# NVIDIA Wayland workarounds (RTX 4050 and similar).
# Applied when the proprietary NVIDIA driver is in use.
if lspci 2>/dev/null | grep -qi 'nvidia' && lsmod 2>/dev/null | grep -qi '^nvidia'; then
    export WLR_NO_HARDWARE_CURSORS=1
    export WLR_RENDERER_ALLOW_SOFTWARE=1
    export GBM_BACKEND=nvidia-drm
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export LIBVA_DRIVER_NAME=nvidia
    export NVD_BACKEND=direct
fi

# Tell hyprmod to use the caelestia managed config in this session.
gsettings set io.github.bluemancz.hyprmod config-path "$HOME/.config/caelestia-hypr/hyprland-gui.lua" 2>/dev/null || true

if [[ -x /usr/bin/start-hyprland ]]; then
    exec /usr/bin/start-hyprland "$@"
fi

exec Hyprland "$@"
